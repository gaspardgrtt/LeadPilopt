{
  "name": "leadpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test:db": "node supabase/tests/rls.test.mjs",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.gen.ts && node scripts/with-header.mjs",
    "db:types:local": "supabase gen types typescript --local --schema public > src/types/database.gen.ts && node scripts/with-header.mjs",
    "db:push": "supabase db push",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "framer-motion": "13.4.3",
    "lucide-react": "1.48.0",
    "next": "15.5.26",
    "papaparse": "5.7.0",
    "radix-ui": "1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
