# Copier ce fichier en .env.local et renseigner les valeurs du projet Supabase
# (Supabase > Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL publique de l'application, utilisée dans les liens de connexion envoyés par email.
# Obligatoire en production (ex. https://app.leadpilot.fr). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Envoi des relances par e-mail via Brevo (facultatif : sans ces variables, le bouton
# « Envoyer par e-mail » reste désactivé). Côté serveur uniquement : ne jamais les préfixer
# par NEXT_PUBLIC_. L'adresse doit être un expéditeur validé dans Brevo (Senders & IP).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
