# Copier ce fichier en .env.local et renseigner les valeurs du projet Supabase
# (Supabase > Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL publique de l'application, utilisée dans les liens de connexion envoyés par email.
# Obligatoire en production (ex. https://app.leadpilot.fr). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé API Anthropic (console.anthropic.com > API Keys), côté serveur uniquement : ne jamais la
# préfixer par NEXT_PUBLIC_. Sans elle, la génération des relances renvoie « non configurée ».
ANTHROPIC_API_KEY=sk-ant-xxx
